#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$SCRIPT_DIR")"

# /etc/hosts is managed as a single delimited block so Maintainerd entries stay
# grouped and never scatter among other projects' entries. The block is removed
# and rewritten on every setup, so it is always authoritative.
HOSTS_BEGIN="# >>> Maintainerd Dev (managed by ./maintainerd — do not edit) >>>"
HOSTS_END="# <<< Maintainerd Dev <<<"

# System-tenant hosts + a fixed set of sample tenants for local multitenant
# testing (real DNS uses a wildcard; /etc/hosts can't, so we enumerate them).
# Sample tenants: seguma, acme, wayne-enterprises, stark-industries, umbrella,
# oscorp — each with an identity and a console subdomain (for multi-QA tenant-
# isolation testing). To test another tenant, add it here and re-run setup. Note
# a tenant only SERVES once it is created in the console; the host just resolves.
MANAGED_HOSTS=(
  # Identity (login UI)
  identity.auth.maintainerd.local
  seguma.identity.auth.maintainerd.local
  acme.identity.auth.maintainerd.local
  wayne-enterprises.identity.auth.maintainerd.local
  stark-industries.identity.auth.maintainerd.local
  umbrella.identity.auth.maintainerd.local
  oscorp.identity.auth.maintainerd.local
  # Console (admin UI)
  console.auth.maintainerd.local
  seguma.console.auth.maintainerd.local
  acme.console.auth.maintainerd.local
  wayne-enterprises.console.auth.maintainerd.local
  stark-industries.console.auth.maintainerd.local
  umbrella.console.auth.maintainerd.local
  oscorp.console.auth.maintainerd.local
  # APIs
  identity-api.auth.maintainerd.local
  console-api.auth.maintainerd.local
  # Messaging & Observability
  rabbitmq.auth.maintainerd.local
  prometheus.auth.maintainerd.local
  grafana.auth.maintainerd.local
  signoz.auth.maintainerd.local
  # Core console (maintainerd's main dashboard) + its REST API host
  console.maintainerd.local
  console-api.maintainerd.local
)

# Hostnames from earlier layouts, removed on setup so no stale lines linger.
# NOTE: bare `auth.maintainerd.local` was the previous identity host; identity
# moved to `identity.auth.maintainerd.local`, so the bare host is now stale.
STALE_HOSTS=(
  public-api.auth.maintainerd.local
  private-api.auth.maintainerd.local
  api.auth.maintainerd.local
  control-api.auth.maintainerd.local
  auth.maintainerd.local
)

# ── usage ────────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
maintainerd — local development environment manager

Usage:
  ./maintainerd init                    Clone all repositories
  ./maintainerd setup                   Configure env, hosts, and trusted local HTTPS
  ./maintainerd up  --profile=<name>    Start services (use -d for detached)
  ./maintainerd down                    Stop all services
  ./maintainerd clean                   Stop services and remove development data

Hosts (added to /etc/hosts during setup — all resolve to the system tenant):
  identity.auth.maintainerd.local       → Identity app (login UI)
  console.auth.maintainerd.local        → Auth console (admin UI)
  identity-api.auth.maintainerd.local            → Data plane API (port 8081)
  console-api.auth.maintainerd.local    → Control plane API (port 8080)
  rabbitmq.auth.maintainerd.local       → RabbitMQ management
  prometheus.auth.maintainerd.local     → Prometheus (observed profile)
  grafana.auth.maintainerd.local        → Grafana (observed profile)
  signoz.auth.maintainerd.local         → SigNoz (observed profile)

  Sample tenants (identity + console subdomains, added for local testing):
    seguma, acme, wayne-enterprises, stark-industries, umbrella, oscorp
  e.g. seguma.identity.auth.maintainerd.local and seguma.console.auth.maintainerd.local.
  A tenant serves only once created in the console; the host just resolves.

Profiles:
  auth           DEV — backend + both frontends in hot-reload (no observability)
  auth-release   RELEASE PARITY — the single all-in-one image (SPAs embedded),
                 built locally from the release Dockerfile, behind nginx on the
                 same DBs + URLs. Test the compiled image before tagging.
  auth-observed  Auth (dev) + Prometheus + Grafana + SigNoz
  maintainerd    The maintainerd core stack — Core + Agent + Docker + Secret (no auth)
  all            Everything EXCEPT observability (auth + maintainerd core stack)
  all-observed   Everything INCLUDING observability (all + Prometheus/Grafana/SigNoz)

Examples:
  ./maintainerd init
  ./maintainerd setup
  ./maintainerd up --profile=auth                     # daily development (hot reload)
  ./maintainerd up --profile=auth-release -d --build  # test the release image locally
  ./maintainerd up --profile=auth-observed -d
  ./maintainerd up --profile=maintainerd -d           # core stack only
  ./maintainerd up --profile=all -d                   # auth + core stack, no observability
  ./maintainerd up --profile=all-observed -d          # everything + observability
  ./maintainerd down
  ./maintainerd clean

The auth and auth-release profiles both listen on :80/:443 and the same
*.auth.maintainerd.local hosts — run one at a time (./maintainerd down first).
EOF
  exit 0
}

# ── helpers ───────────────────────────────────────────────────────────────────
clone_repo() {
  local repo="$1"
  local dir="${PARENT_DIR}/${repo}"
  if [ -d "$dir/.git" ]; then
    echo "  [SKIP] ${repo} already exists — pulling latest"
    (cd "$dir" && git pull --ff-only 2>/dev/null || true)
  else
    echo "  [CLONE] ${repo}"
    git clone "https://github.com/maintainerd/${repo}.git" "$dir"
  fi
}

# maintainerd-dev is the single source of truth for local env vars, so setup
# always overwrites each repo's .env from the sample. Any hand-edits to a repo
# .env are intentionally discarded — put durable local overrides in the sample.
copy_env_sample() {
  local repo="$1"
  local sample="$2"
  local target="${PARENT_DIR}/${repo}/.env"
  if [ -f "$target" ]; then
    echo "  [OVERWRITE] ${repo}/.env from .env-samples/${sample}"
  else
    echo "  [DONE] ${repo}/.env created from .env-samples/${sample}"
  fi
  cp "${SCRIPT_DIR}/.env-samples/${sample}" "$target"
}

# JWT keypair and app secrets are generated once and cached in .secrets/ (which
# is gitignored). They are reused across setups so tokens and encrypted data
# stay valid; `./maintainerd clean` wipes the cache for a true reset.
ensure_secrets() {
  local secrets_dir="${SCRIPT_DIR}/.secrets"
  local secrets_env="${secrets_dir}/auth.secrets.env"

  if [ -f "$secrets_env" ]; then
    echo "  [SKIP] Local secrets already generated (.secrets/auth.secrets.env)"
    return 0
  fi

  echo "  [CREATE] Generating local JWT keypair and application secrets"
  mkdir -p "$secrets_dir"
  chmod 700 "$secrets_dir"

  # Reuse the JWT helper; it writes jwt_env_vars.txt in ready-to-source .env form.
  # Invoked via bash because the script is not marked executable in the repo.
  bash "${SCRIPT_DIR}/scripts/generate-jwt-keys.sh" 4096 "${secrets_dir}/jwt" >/dev/null

  {
    echo "# ---- Generated secrets (auto-generated by ./maintainerd setup) --------------"
    cat "${secrets_dir}/jwt/jwt_env_vars.txt"
    # APP_ENCRYPTION_KEY is used as the raw AES-256 key: the backend requires the
    # value to be EXACTLY 32 bytes (it is not base64-decoded). `-base64 24`
    # yields exactly 32 base64 chars (24 bytes → 32 chars, no padding) = 32 bytes.
    # Do NOT use `-base64 32` (that is 44 chars and fails the 32-byte check).
    echo "APP_ENCRYPTION_KEY=\"$(openssl rand -base64 24)\""
    # HMAC key has no fixed-length requirement.
    echo "HMAC_SECRET_KEY=\"$(openssl rand -base64 32)\""
    # SETUP_BOOTSTRAP_TOKEN gates the gRPC SetupService so CORE can provision this
    # instance (system tenant + admin + control service) over gRPC. Standalone/REST
    # setup does not need it; generated here so local ecosystem/gRPC-setup testing
    # works (callers send it as the `x-setup-token` gRPC metadata header).
    echo "SETUP_BOOTSTRAP_TOKEN=\"$(openssl rand -hex 32)\""
  } > "$secrets_env"

  chmod 600 "$secrets_env"
  echo "  [DONE] Secrets cached in .secrets/ (reused across setups; wiped by clean)"
}

# Append the cached secret block to a freshly-copied .env.
inject_secrets() {
  local repo="$1"
  local target="${PARENT_DIR}/${repo}/.env"
  local secrets_env="${SCRIPT_DIR}/.secrets/auth.secrets.env"
  [ -f "$target" ] || return 0
  [ -f "$secrets_env" ] || return 0
  printf '\n' >> "$target"
  cat "$secrets_env" >> "$target"
  echo "  [DONE] ${repo}/.env — secrets injected"
}

configure_https_env() {
  local file="$1"
  [ -f "$file" ] || return 0

  sed -i \
    -e 's|http://console-api\.auth\.maintainerd\.local|https://console-api.auth.maintainerd.local|g' \
    -e 's|http://identity-api\.auth\.maintainerd\.local|https://identity-api.auth.maintainerd.local|g' \
    -e 's|http://console\.auth\.maintainerd\.local|https://console.auth.maintainerd.local|g' \
    -e 's|http://identity\.auth\.maintainerd\.local|https://identity.auth.maintainerd.local|g' \
    -e 's|^COOKIE_SECURE=false$|COOKIE_SECURE=true|' \
    -e 's|^WEBAUTHN_RP_ID=localhost$|WEBAUTHN_RP_ID=auth.maintainerd.local|' \
    "$file"
}

# Emit the managed block content (markers + one line per managed host).
# MANAGED_HOSTS is the single source of truth — the removal step and this writer
# read the SAME list, so a host added there is always both cleaned and written
# (previously this was a second hardcoded list that silently drifted).
build_hosts_block() {
  echo "$HOSTS_BEGIN"
  echo "# ============================================"
  echo "# Maintainerd Dev - Host configuration"
  echo "# All hosts resolve to 127.0.0.1 (the nginx TLS edge)."
  echo "# ============================================"
  local h
  for h in "${MANAGED_HOSTS[@]}"; do
    echo "127.0.0.1 $h"
  done
  echo "$HOSTS_END"
}

# Rewrite /etc/hosts: drop the old managed block and any loose managed/stale
# lines, then append a fresh block. Idempotent and duplicate-free.
configure_hosts_block() {
  if grep -qF "$HOSTS_BEGIN" /etc/hosts 2>/dev/null; then
    echo "  [UPDATE] Refreshing the Maintainerd Dev block in /etc/hosts"
  else
    echo "  [ADD]    Writing the Maintainerd Dev block to /etc/hosts"
  fi

  # 1) Remove a previous managed block (between the markers, inclusive). The
  #    markers start with '#', so '|' is used as the sed address delimiter.
  sudo sed -i "\|^${HOSTS_BEGIN}\$|,\|^${HOSTS_END}\$|d" /etc/hosts

  # 2) Remove loose lines for managed + stale hostnames (from older setups),
  #    matched only as whole hostnames so manual {tenant}. lines are untouched.
  local h pat
  for h in "${MANAGED_HOSTS[@]}" "${STALE_HOSTS[@]}"; do
    pat="[[:space:]]${h//./\\.}\$"
    sudo sed -i "/${pat}/d" /etc/hosts
  done

  # 3) Append the fresh block.
  build_hosts_block | sudo tee -a /etc/hosts > /dev/null
}

# ── init ──────────────────────────────────────────────────────────────────────
cmd_init() {
  echo "==> Cloning repositories into ${PARENT_DIR}"

  # Auth: backend + console/identity frontends (web/console, web/identity), shipped
  # as a single all-in-one image (auth* profiles).
  clone_repo "maintainerd-auth"

  # The maintainerd core stack + its client SDK — built by the maintainerd / all /
  # all-observed profiles. The Docker build uses the parent dir as its context so
  # these siblings must be present for the per-module replace directives to resolve.
  clone_repo "maintainerd"        # core control plane
  clone_repo "maintainerd-sdk"    # client SDK + kit (agent/secret build against it)
  clone_repo "maintainerd-secret" # standalone secret store
  clone_repo "maintainerd-agent"  # executor
  clone_repo "maintainerd-docker" # runtime driver

  echo ""
  echo "==> Repos cloned. Run './maintainerd setup' to create the .env, /etc/hosts, and local certs."
}

# ── setup ─────────────────────────────────────────────────────────────────────
cmd_setup() {
  echo "==> Configuring /etc/hosts"
  configure_hosts_block

  echo ""
  echo "==> Ensuring local secrets"
  ensure_secrets

  echo ""
  echo "==> Creating the .env file from the sample (overwrites existing)"

  # Single all-in-one image: only the backend .env is needed. The frontends read
  # their config at runtime inside the image (same-origin defaults via nginx).
  copy_env_sample "maintainerd-auth"          "maintainerd-auth.env"

  echo ""
  echo "==> Injecting secrets into maintainerd-auth/.env"
  inject_secrets "maintainerd-auth"

  echo ""
  echo "==> Configuring HTTPS application origins"
  configure_https_env "${PARENT_DIR}/maintainerd-auth/.env"

  echo ""
  echo "==> Generating and trusting the local HTTPS certificate"
  "${SCRIPT_DIR}/scripts/generate-local-certs.sh" --trust

  echo ""
  echo "==> Syncing AI/agent config files to the repo"

  for repo in maintainerd-auth; do
    target="${PARENT_DIR}/${repo}"
    if [ -d "$target" ]; then
      cp -r "${SCRIPT_DIR}/ai-files/." "$target/"
      echo "  [DONE] ${repo} — AI config synced"
    fi
  done

  echo ""
  echo "==> Done. Start a stack:"
  echo "      ./maintainerd up --profile=auth -d          # auth only"
  echo "      ./maintainerd up --profile=maintainerd -d   # core stack only"
  echo "      ./maintainerd up --profile=all -d           # auth + core + console (console.maintainerd.local)"
}

# ── up ────────────────────────────────────────────────────────────────────────
cmd_up() {
  local profile=""
  local otel_enabled="false"
  # Core-driven setup: only the full-stack profiles run Auth alongside Core, so
  # only they enable Core's setup orchestration (and hand Auth the matching
  # bootstrap token + gRPC). Keeping this empty for auth-only profiles leaves
  # Auth's REST setup wizard as the bootstrap path.
  local setup_enabled="false"
  local auth_setup_token=""
  local auth_grpc_enabled=""
  local -a compose_args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --profile=*) profile="${1#*=}" ;;
      --profile)
        if [ "$#" -lt 2 ]; then
          echo "ERROR: --profile requires a value"
          exit 1
        fi
        profile="$2"
        shift
        ;;
      -d) compose_args+=("-d") ;;
      # Rebuild images before starting — needed to pick up code changes in the
      # auth-release profile (the compiled image is not hot-reloaded).
      --build) compose_args+=("--build") ;;
      *) usage ;;
    esac
    shift
  done

  if [ -z "$profile" ]; then
    echo "ERROR: --profile=<name> is required"
    usage
  fi

  case "$profile" in
    auth|auth-release|maintainerd|all) ;;
    auth-observed|all-observed) otel_enabled="true" ;;
    *)
      echo "ERROR: unknown profile '${profile}'. Use 'auth', 'auth-release', 'auth-observed', 'maintainerd', 'all', or 'all-observed'."
      exit 1
      ;;
  esac

  # The full stack (auth + core) wires Core to Auth's gRPC setup so the console
  # setup wizard can drive provisioning. setup_enabled stays false: the wizard
  # (not an unattended on-boot run) creates the tenant + admin. Set
  # MAINTAINERD_SETUP_ENABLED=true yourself for an unattended env-driven install.
  case "$profile" in
    all|all-observed)
      setup_enabled="false"
      auth_setup_token="devtoken"
      auth_grpc_enabled="true"
      ;;
  esac

  echo "==> Starting profile: ${profile}"
  cd "$SCRIPT_DIR"
  "${SCRIPT_DIR}/scripts/generate-local-certs.sh"
  MAINTAINERD_OTEL_ENABLED="$otel_enabled" \
  MAINTAINERD_SETUP_ENABLED="$setup_enabled" \
  MAINTAINERD_AUTH_SETUP_TOKEN="$auth_setup_token" \
  MAINTAINERD_AUTH_GRPC_ENABLED="$auth_grpc_enabled" \
    docker compose --profile "$profile" up "${compose_args[@]}" --remove-orphans
}

# ── down ──────────────────────────────────────────────────────────────────────
cmd_down() {
  cd "$SCRIPT_DIR"
  # Activate every profile so Compose includes all managed services in the
  # shutdown model, regardless of which profile was used for `up`. auth-release
  # is not part of `all`, so it is named explicitly.
  docker compose --profile all-observed --profile auth-release down --remove-orphans
  echo "All services stopped."
}

# ── clean ────────────────────────────────────────────────────────────────────
cmd_clean() {
  cd "$SCRIPT_DIR"
  docker compose --profile all-observed --profile auth-release down --remove-orphans --volumes
  if [ -d "${SCRIPT_DIR}/.secrets" ]; then
    rm -rf "${SCRIPT_DIR}/.secrets"
    echo "Local secret cache (.secrets/) removed — setup will regenerate keys."
  fi
  echo "All services stopped and development volumes removed."
}

# ── dispatch ──────────────────────────────────────────────────────────────────
case "${1:-}" in
  init)    shift; cmd_init "$@" ;;
  setup)   shift; cmd_setup "$@" ;;
  up)      shift; cmd_up "$@" ;;
  down)    shift; cmd_down "$@" ;;
  clean)   shift; cmd_clean "$@" ;;
  *)       usage ;;
esac
