# =============================================================================
# maintainerd-auth — Development Environment (Docker Compose)
# =============================================================================

APP_ENV=development
APP_VERSION=1.0.0

# ---- Hostnames --------------------------------------------------------------
# The host part of every value below is fully customizable per deployment/org.
# Two different scheme rules apply, on purpose:
#
# API hostnames — MUST include the scheme (https://). These are the OIDC ISSUER
# and are used verbatim as the JWT `iss` claim, in the /.well-known discovery
# document, as WebAuthn origins, and in direct URL concatenation. Per OIDC the
# issuer is a full URL; a scheme-less value would break token validation,
# discovery, federation and WebAuthn. The host is flexible; the scheme is not.
#   APP_PUBLIC_HOSTNAME  = data-plane API  (:8081) — OAuth2/OIDC/public REST
#   APP_PRIVATE_HOSTNAME = control-plane API (:8080) — tenant/client management
APP_PUBLIC_HOSTNAME=https://identity-api.auth.maintainerd.local
APP_PRIVATE_HOSTNAME=https://console-api.auth.maintainerd.local
MANAGEMENT_PORT=8082
#
# Frontend hostnames — the SYSTEM-tenant host per surface. These are DERIVATION
# BASES: the backend derives per-tenant hosts ({tenant}.<base>, system = bare
# base) and resolves inbound hosts (GET /tenant?domain=) by stripping the base,
# so an org can name them anything (e.g. console-auth.ssi.com). The backend
# normalizes the scheme in/out, so these MAY be scheme-less — they are kept with
# https:// here only because one policy-locked file (service_forgot_password.go)
# concatenates the raw value; once that routes through shared.FrontendURL they
# can drop the scheme.
APP_FRONTEND_IDENTITY_HOSTNAME=https://identity.auth.maintainerd.local
APP_FRONTEND_CONSOLE_HOSTNAME=https://console.auth.maintainerd.local

# ---- gRPC (service-to-service, mTLS) ----------------------------------------
# mTLS is fully enabled locally. `./maintainerd setup` generates the certs under
# maintainerd-dev/.certs/grpc/ and mounts that dir read-only into the container
# at /etc/maintainerd/grpc-certs. Callers must present client.crt/client.key
# (signed by the same local CA) — e.g. grpcurl against localhost:50051. See the
# maintainerd-dev README for a ready-to-run grpcurl example.
GRPC_REQUIRE_MTLS=true
GRPC_TLS_CERT_FILE=/etc/maintainerd/grpc-certs/server.crt
GRPC_TLS_KEY_FILE=/etc/maintainerd/grpc-certs/server.key
GRPC_CLIENT_CA_FILE=/etc/maintainerd/grpc-certs/ca.crt
# SETUP_BOOTSTRAP_TOKEN gates the gRPC SetupService (system tenant/admin/control-service
# provisioning by CORE). It is auto-generated into .env by `./maintainerd setup`
# (see ensure_secrets) — not set here. Leave unset to disable gRPC setup entirely;
# standalone instances bootstrap through the REST setup wizard instead.

# ---- CORS -------------------------------------------------------------------
# System-tenant origins. Regular tenants ({tenant}.auth / {tenant}.console.auth)
# are validated dynamically by the backend against the tenant's registered host.
CORS_ALLOWED_ORIGINS=https://console.auth.maintainerd.local,https://identity.auth.maintainerd.local

# ---- WebAuthn ---------------------------------------------------------------
# RP ID stays at the service apex so a single credential is valid across every
# tenant subdomain (all *.auth.maintainerd.local origins share this suffix).
WEBAUTHN_EXTRA_ORIGINS=https://console.auth.maintainerd.local,https://identity.auth.maintainerd.local
WEBAUTHN_RP_ID=auth.maintainerd.local

# ---- Database ---------------------------------------------------------------
DB_HOST=postgres-db
DB_PORT=5432
DB_USER=devuser
DB_PASSWORD=Pass123
DB_NAME=maintainerd
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300
DB_STATEMENT_TIMEOUT_MS=30000

# ---- Redis ------------------------------------------------------------------
REDIS_ADDR=redis-db:6379
REDIS_PASSWORD=Pass123
REDIS_TLS=false

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_URL=amqp://devuser:Pass123@rabbitmq:5672/

# ---- Secret Management -------------------------------------------------------
SECRET_PROVIDER=env
SECRET_PREFIX=maintainerd/auth

# ---- JWT & Encryption Keys (dev-only) ---------------------------------------
# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, APP_ENCRYPTION_KEY and HMAC_SECRET_KEY are
# NOT stored here. `./maintainerd setup` generates them once, caches them in
# maintainerd-dev/.secrets/ (gitignored), and appends them to this .env on every
# setup. They persist across setups and are wiped only by `./maintainerd clean`.
JWT_KEY_ROTATION_PERIOD_SECONDS=86400
SECRET_REFRESH_PERIOD_SECONDS=300

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# ---- Cookies ----------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# ---- OpenTelemetry (optional) ------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=maintainerd-auth
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
